{
  "name": "sparkbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:browser": "tsx scripts/browser-smoke.ts",
    "test:live:anthropic": "tsx scripts/live-turn.ts anthropic",
    "test:live:openai": "tsx scripts/live-turn.ts openai",
    "test:live:openrouter": "tsx scripts/live-turn.ts openrouter",
    "dev:server": "node --experimental-strip-types server/main.ts",
    "start": "node --experimental-strip-types server/main.ts",
    "test:ws": "tsx scripts/ws-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@pierre/diffs": "1.3.0-beta.10",
    "@wasmer/sdk": "^0.19.0",
    "class-variance-authority": "^0.7.1",
    "diff": "^9.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lucide-react": "^0.577.0",
    "monaco-editor": "0.56.0",
    "openai": "^7.28.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@types/diff": "^8.0.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
